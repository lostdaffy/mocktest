# ---- Environment & secrets ----
.env
.env.*
!.env.example

# ---- Dependencies ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ---- Logs ----
logs/
*.log

# ---- Runtime / process files ----
pids/
*.pid
*.seed
*.pid.lock

# ---- Coverage / test output ----
coverage/
.nyc_output/

# ---- Build output ----
dist/
build/

# ---- Uploads / temp files (adjust if you store user uploads locally) ----
uploads/
tmp/
temp/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp

# ---- Misc ----
*.tgz
*.tar.gz
.cache/
# ---- Database backups ----
# These hold real user data - phone numbers, emails, password hashes and
# payment records. They must never enter git history, public repo or not.
backups/

# ---- Test run output ----
# Written by the suites in tests/ as they run; never worth committing.
tests/gen-calls.jsonl
tests/captured.jsonl
tests/tmp-*.js
