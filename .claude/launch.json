{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "admin",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "website",
      "port": 4176
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "mobile",
      "port": 8081,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:5056/api",
        "CI": "1",
        "BROWSER": "none"
      }
    },
    {
      "name": "mobile-web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082",
        "-c"
      ],
      "cwd": "mobile",
      "port": 8082,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:5056/api",
        "CI": "1",
        "BROWSER": "none"
      }
    },
    {
      "name": "website-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "cwd": "website",
      "port": 4176
    },
    {
      "name": "admin-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "cwd": "admin",
      "port": 5174,
      "env": {
        "VITE_API_URL": "http://localhost:5080/api"
      }
    }
  ]
}
