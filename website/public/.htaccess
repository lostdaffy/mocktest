# Apache / LiteSpeed config for the public website at rankveer.com
#
# Vite copies this file from website/public/ into dist/ on every build.
# Upload the CONTENTS of website/dist/ into public_html/. This is a hidden
# file - turn on "Show Hidden Files" in cPanel File Manager or it will be
# silently skipped, and HTTPS, caching and the 404 page will stop working.
#
# The admin panel lives in public_html/admin/ with its OWN .htaccess. A
# folder with its own RewriteEngine does not inherit rules from here, so
# nothing below can break admin routing.

ErrorDocument 404 /404.html

# The server has directory listing switched on by default, which let anyone
# open rankveer.com/assets/ and browse every file. Turn it off.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One canonical host: www.rankveer.com -> rankveer.com, so Google doesn't
  # see two copies of every page.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Every CSS/JS file is emitted by Vite with a content hash in its name
  # (e.g. assets/main-B1x9Qa2c.js), so a new build always means a new URL
  # and these are safe to cache for a year.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Pages must always be fresh, or visitors keep seeing an old version
  # (pointing at deleted asset files) after an update.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Never serve project/tooling files if they get uploaded by mistake.
<FilesMatch "^(vite\.config\.js|tailwind\.config\.js|site\.config\.json|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>
